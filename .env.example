# Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=triqx_dev_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# JWT Secrets
JWT_SECRET=change_this_access_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_refresh_secret
# Sliding session: each refresh issues a new token valid this many days (default 90)
REFRESH_TOKEN_EXPIRES_IN_DAYS=90
# Absolute cap from the original OTP login; after this the user must sign in again (default 365)
SESSION_MAX_AGE_DAYS=365

# Option 1: Twilio Verify Service (Recommended for Twilio Trial Accounts / India +91)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Twilio Programmable SMS / Content Template API
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Fast2SMS (Popular Indian SMS Gateway - Instant OTP without template approval)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Request size + AI spend caps
BODY_LIMIT=50mb
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=50
AI_RATE_LIMIT_DAILY_MAX=1000

# Grace window (ms) to replay a just-rotated refresh token whose response was lost
REFRESH_REUSE_GRACE_MS=120000
