# Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=triqx_dev_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# JWT Secrets
JWT_SECRET=change_this_access_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Option 1: Twilio Verify Service (Recommended for Twilio Trial Accounts / India +91)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Twilio Programmable SMS / Content Template API
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Fast2SMS (Popular Indian SMS Gateway - Instant OTP without template approval)
FAST2SMS_API_KEY=your_fast2sms_api_key_here